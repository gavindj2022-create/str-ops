# STR Ops — environment template.
# Copy to .dev.vars for local `wrangler pages dev`, and set each as a Cloudflare
# secret for production:  wrangler pages secret put <NAME> --project-name=str-ops
# NEVER commit the filled-in version. .dev.vars and .env are gitignored.

# ── Airbnb / VRBO iCal feeds ─────────────────────────────────────────────
# BLOCKED: only the Airbnb listing owner (Anabelle) or a full-access co-host
# (Gale) can export these. Each listing → Availability → Export Calendar → copy
# the .ics link. Until set, the app runs on demo/seed data (this is expected).
ICAL_MILPOINT_AIRBNB=
ICAL_MILPOINT_VRBO=
ICAL_WESTGATE_AIRBNB=
ICAL_GALENA_AIRBNB=
ICAL_GALENA_VRBO=
ICAL_HICKORY_AIRBNB=
ICAL_HICKORY_VRBO=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate a keypair once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:gavindj2022@gmail.com

# ── Auth ─────────────────────────────────────────────────────────────────
# Random 32+ char string; used to HMAC-sign session tokens.
SESSION_SECRET=
